#!/usr/bin/env bash
set -euo pipefail

refuse() {
  echo "$*" >&2
  exit 1
}

version="${1:-}"
sha="${2:-}"
part="(0|[1-9][0-9]*)"
[[ "$version" =~ ^$part[.]$part[.]$part$ ]] || refuse "usage: publish-release x.y.z <commit sha> (no leading zeros)"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || refuse "expected a full commit sha, got: $sha"
[[ -n "${GH_REPO:-}" ]] || refuse "set GH_REPO to owner/repo"
tag="v$version"

state="$(gh api --paginate "repos/$GH_REPO/releases" \
  --jq ".[] | select(.tag_name == \"$tag\") | [.draft, .prerelease] | map(tostring) | join(\" \")")" ||
  refuse "could not list the releases of $GH_REPO"
[[ "$(grep -c . <<<"$state")" -le 1 ]] || refuse "more than one release uses $tag; fix it by hand"
if [[ -n "$state" ]]; then
  read -r draft prerelease <<<"$state"
  [[ "$prerelease" == false ]] || refuse "$tag is a prerelease; fix it by hand"
  [[ "$draft" == false ]] || refuse "$tag is a draft; fix it by hand"
fi

current="$(gh api "repos/$GH_REPO/git/matching-refs/tags/$tag" \
  --jq ".[] | select(.ref == \"refs/tags/$tag\") | .object.type + \" \" + .object.sha")" ||
  refuse "could not look up tag $tag"
if [[ -n "$current" ]]; then
  [[ "$current" == "commit $sha" ]] || refuse "tag $tag already points at $current, not $sha; fix it by hand"
else
  gh api --method POST "repos/$GH_REPO/git/refs" -f ref="refs/tags/$tag" -f sha="$sha" >/dev/null
fi

if [[ -z "$state" ]]; then
  gh release create "$tag" --verify-tag --title "Arcade Base $version" --generate-notes
fi

milestones="$(gh api --paginate "repos/$GH_REPO/milestones?state=open" --jq ".[] | select(.title == \"$version\") | .number")"
for milestone in $milestones; do
  gh api --method PATCH "repos/$GH_REPO/milestones/$milestone" -f state=closed >/dev/null
done
